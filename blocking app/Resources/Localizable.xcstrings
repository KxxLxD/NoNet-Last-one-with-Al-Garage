    "Block Forever is on": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احظر للأبد مفعّل"
          }
        }
      }
    },
    "Block Forever stays free forever.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«احظر للأبد» يبقى مجاني للأبد."
          }
        }
      }
    },
    "Block Forever · unlocks in %lld days": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · ينفك بعد %lld أيام"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · ينفك بعد %lld يوم"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · ينفك بعد يوم"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · ينفك بعد %lld يوم"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · ينفك بعد يومين"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · ينفك اليوم"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Block Forever · unlocks in %lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Block Forever · unlocks in %lld days"
                }
              }
            }
          }
        }
      }
    },
    "Block Forever: porn, gambling and dating — blocked for good. Free forever.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احظر للأبد: الإباحية والقمار والمواعدة — محظورة للأبد. مجاناً للأبد."
          }
        }
      }
    },
    "Block adult websites": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر مواقع البالغين"
          }
        }
      }
    },
    "Block ended 🎉": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى الحظر 🎉"
          }
        }
      }
    },
    "Block started": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ الحظر"
          }
        }
      }
    },
    "Block the apps and websites that steal your time, and protect yourself for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احظر التطبيقات والمواقع اللي تسرق وقتك، واحمِ نفسك للأبد."
          }
        }
      }
    },
    "Blocked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محظورة"
          }
        }
      }
    },
    "Blocking during prayer times": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحظر وقت الصلاة"
          }
        }
      }
    },
    "Blocking isn't working?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحظر ما يشتغل؟"
          }
        }
      }
    },
    "Blocks porn, gambling and dating websites in every browser.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحظر مواقع الإباحية والقمار والمواعدة في كل المتصفحات."
          }
        }
      }
    },
    "Both need your partner's current PIN.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاثنين يحتاجون رمز شريكك الحالي."
          }
        }
      }
    },
    "Break ends in a minute": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستراحة تخلص بعد دقيقة"
          }
        }
      }
    },
    "Breaks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستراحات"
          }
        }
      }
    },
    "Breaks per 24 hours: %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الاستراحات في اليوم: %lld"
          }
        }
      }
    },
    "Can't be stopped, edited or deleted while active, and Samla can't be deleted. No breaks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تقدر توقفها أو تعدلها أو تحذفها وهي شغالة، وما ينحذف الصملة. بدون استراحات."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        }
      }
    },
    "Cancel Request": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الطلب"
          }
        }
      }
    },
    "Challenges with points and levels": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديات بنقاط ومستويات"
          }
        }
      }
    },
    "Change Partner": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير الشريك"
          }
        }
      }
    },
    "Check inputs": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الإدخالات"
          }
        }
      }
    },
    "Check name, items and duration": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاسم والعناصر والمدة"
          }
        }
      }
    },
    "Choose Apps & Categories": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التطبيقات والفئات"
          }
        }
      }
    },
    "Choose Schedule under When, then add days and times. Blocking starts and stops automatically, even when Samla is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «جدول» تحت «متى»، وبعدين أضف الأيام والأوقات. الحظر يبدأ ويوقف تلقائياً حتى لو الصملة مقفول."
          }
        }
      }
    },
