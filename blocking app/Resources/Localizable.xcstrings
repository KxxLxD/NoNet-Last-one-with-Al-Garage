        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاسم والعناصر والمدة"
          }
        }
      }
    },
    "Choose Apps & Categories": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التطبيقات والفئات"
          }
        }
      }
    },
    "Choose Schedule under When, then add days and times. Blocking starts and stops automatically, even when Samla is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
