          }
        }
      }
    },
    "Allow Samla to use Screen Time so it can block content.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للصملة باستخدام مدة استخدام الجهاز عشان يقدر يحظر المحتوى."
          }
        }
      }
    },
    "Allow Screen Time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بمدة استخدام الجهاز"
          }
        }
      }
    },
    "Also lock all 17+ apps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقفل كل تطبيقات 17+ كمان"
