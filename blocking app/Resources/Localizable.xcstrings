    "Allow Samla to use Screen Time so it can block content.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للصملة باستخدام «مدة استخدام الجهاز» ليتمكن من حظر المحتوى."
          }
        }
      }
    },
    "Allow Screen Time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بمدة استخدام الجهاز"
          }
        }
      }
    },
    "Also lock all 17+ apps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
