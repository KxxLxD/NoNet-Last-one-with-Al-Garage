    },
    "Block Forever stays free forever.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى «احظر للأبد» مجانيًا إلى الأبد."
          }
        }
      }
    },
    "Block Forever · unlocks in %lld days": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
