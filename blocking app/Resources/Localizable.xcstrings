      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر مواقع البالغين"
          }
        }
      }
    },
    "Block ended 🎉": {
      "localizations": {
        "ar": {
          "stringUnit": {
