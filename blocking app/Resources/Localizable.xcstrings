              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · يُلغى بعد يوم"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · يُلغى بعد %lld يوم"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · يُلغى بعد يومين"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "احظر للأبد · يُلغى اليوم"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Block Forever · unlocks in %lld day"
                }
