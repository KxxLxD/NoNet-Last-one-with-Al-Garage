    "Block Forever: porn, gambling and dating — blocked for good. Free forever.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احظر للأبد: الإباحية والقمار والمواعدة — محظورة إلى الأبد. مجانًا إلى الأبد."
          }
        }
      }
    },
