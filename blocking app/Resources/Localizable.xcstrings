      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ الحظر"
          }
        }
      }
    },
    "Block the apps and websites that steal your time, and protect yourself for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احظر التطبيقات والمواقع التي تسرق وقتك، واحمِ نفسك إلى الأبد."
          }
        }
      }
    },
    "Blocked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محظورة"
          }
        }
      }
    },
    "Blocking during prayer times": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحظر في أوقات الصلاة"
          }
        }
      }
    },
    "Blocking isn't working?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحظر لا يعمل؟"
          }
        }
      }
    },
    "Blocks porn, gambling and dating websites in every browser.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحظر مواقع الإباحية والقمار والمواعدة في جميع المتصفحات."
          }
        }
      }
    },
    "Both need your partner's current PIN.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب كلاهما رمز شريكك الحالي."
          }
        }
      }
    },
    "Break ends in a minute": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي الاستراحة بعد دقيقة"
          }
        }
      }
    },
    "Breaks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستراحات"
          }
        }
      }
    },
    "Breaks per 24 hours: %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الاستراحات خلال 24 ساعة: %lld"
          }
        }
      }
    },
    "Can't be stopped, edited or deleted while active, and Samla can't be deleted. No breaks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إيقافها أو تعديلها أو حذفها أثناء نشاطها، ولا يمكن حذف الصملة. بدون استراحات."
          }
        }
      }
    },
