/*
  Localizable.strings
  blocking app

  English strings used outside the main Swift source (e.g. push notifications
  emitted by the BlockingMonitor extension and CloudKitPartnerStore's
  CKQuerySubscription template). Apple displays the localized version that
  matches the recipient device's language, not the sender's.

  %@ in PARTNER_BREAK_BODY is the list name (see notificationInfo.alertLocalizationArgs
  in CloudKitPartnerStore.setupSubscriptions). Phrasing reads naturally when
  the substitution is a list name, e.g. "Focus Time".
*/

"PARTNER_BREAK_TITLE" = "Request from your partner";
"PARTNER_BREAK_BODY" = "New request about \"%@\" — open NoNet to review.";
